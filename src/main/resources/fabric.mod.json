{
  "schemaVersion": 1,
  "id": "pulseoptimize",
  "version": "${version}",
  "name": "PulseOptimize",
  "description": "An all-in-one Minecraft performance optimization suite for Fabric. Monitors FPS, frame-time, memory and rendering workloads. Provides intelligent diagnostics, configurable visual optimizations, and an optional AI performance advisor.",
  "authors": [
    "Ahmad"
  ],
  "contact": {
    "homepage": "https://github.com/ahmad/pulseoptimize",
    "sources": "https://github.com/ahmad/pulseoptimize",
    "issues": "https://github.com/ahmad/pulseoptimize/issues"
  },
  "license": "MIT",
  "icon": "assets/pulseoptimize/textures/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.ahmad.pulseoptimize.PulseOptimize"
    ],
    "modmenu": [
      "dev.ahmad.pulseoptimize.ui.ModMenuIntegration"
    ]
  },
  "mixins": [
    "pulseoptimize.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "fabric-api": ">=0.102.0",
    "minecraft": "1.21.1",
    "java": ">=21"
  },
  "suggests": {
    "modmenu": ">=11.0.0"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "https://discord.gg/pulseoptimize"
      }
    }
  }
}
